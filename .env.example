# MongoDB connection string (local MongoDB Atlas cluster, or Render managed MongoDB).
# Update this to your own database, then run: npx prisma db push && npm run db:seed
DATABASE_URL="mongodb://localhost:27017/aetheria"

# Secret used to sign the admin session token (JWT).
# Generate a strong one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin default credentials used by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@aetheria.design"
SEED_ADMIN_PASSWORD="AetheriaAdmin2024"

# Cloudinary image uploads (optional locally; required on Render).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_ENABLED="false"